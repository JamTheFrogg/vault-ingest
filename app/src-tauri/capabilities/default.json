{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window and the call popup: engine address, recorder state, opening notes in Obsidian or links in the browser.",
  "windows": ["main", "popup"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "obsidian://*" }, { "url": "https://*" }, { "url": "http://*" }]
    }
  ]
}
